# Development: /api uses the Vite proxy below.
# Production: set the real HTTPS Render origin in Vercel; /api is appended once.
# An origin ending in /api is also supported. Never put secrets in VITE_* variables.
VITE_API_URL=/api
# Development only; never used by the browser or production builds.
API_PROXY_TARGET=http://127.0.0.1:4000
