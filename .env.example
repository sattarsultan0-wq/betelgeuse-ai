# Development: /api uses the Vite proxy below.
# Production: /api uses the Vercel proxy, avoiding third-party cookies.
# Direct HTTPS backend origins are supported but need same-site domains for mobile auth.
# Never put secrets in VITE_* variables.
VITE_API_URL=/api
# Development only; never used by the browser or production builds.
API_PROXY_TARGET=http://127.0.0.1:4000
# Vercel deploy configuration only. Set the REAL HTTPS Render origin (no /api).
# BACKEND_ORIGIN=
